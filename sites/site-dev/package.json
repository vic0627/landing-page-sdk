{
  "name": "@sites/site-dev",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {},
  "dependencies": {
    "@landing-page-sdk/utils-node": "*"
  },
  "nx": {
    "$schema": "../../node_modules/nx/schemas/project-schema.json",
    "projectType": "application",
    "targets": {
      "dev": {
        "executor": "@landing-page-sdk/source:vite",
        "dependsOn": [
          "^build"
        ],
        "options": {
          "mode": "dev",
          "cwd": "{projectRoot}"
        }
      },
      "build": {
        "executor": "@landing-page-sdk/source:vite",
        "dependsOn": [
          "^build"
        ],
        "options": {
          "mode": "build",
          "cwd": "{projectRoot}"
        }
      },
      "preview": {
        "executor": "@landing-page-sdk/source:vite",
        "dependsOn": [
          "^build"
        ],
        "options": {
          "mode": "preview",
          "cwd": "{projectRoot}"
        }
      }
    }
  }
}
