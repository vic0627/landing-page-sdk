{
  "$schema": "https://json-schema.org/schema",
  "$id": "Component",
  "title": "",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "",
      "pattern": "^[A-Za-z][A-Za-z0-9-]*$",
      "x-prompt": "Please enter the component name"
    },
    "project": {
      "type": "string",
      "description": "Which project do you want to put the component in?",
      "pattern": "^(@[a-z0-9-]+\\/)?[a-z0-9-]+$"
    },
    "path": {
      "type": "string",
      "description": "Which path do you want to put the component under?",
      "pattern": "^(?!.*[-/]{2})[a-z-/]+$"
    },
    "useTs": {
      "type": "boolean",
      "description": "",
      "x-prompt": "Do you want to use TypeScript?"
    },
    "framework": {
      "type": "string",
      "description": "",
      "enum": ["none", "vue", "react"],
      "default": "none",
      "x-prompt": "Which SPA framework do you want to use?"
    }
  },
  "required": ["name"]
}
