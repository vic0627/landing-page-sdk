import { useEffect, useState } from 'react';
import { manifestResolver } from '@landing-page-sdk/utils-browser';
import manifest from 'virtual:route-manifest';

<% if (useTs) { %>interface RouterLinkProps {
  to: string;
  locale?: string;
  children?: ReactNode;
}<% } %>

export default function RouterLink({ to, locale, children }<% if (useTs) { %>: RouterLinkProps<% } %>) {
  const [href, setHref] = useState('/');

  useEffect(() => {
    const { route: fromRoute } = __SDK_PAGE_CTX__;
    const { site, lang: fromLocale } = __SDK_PAGE_CTX__.data;

    const resolved = manifestResolver(manifest, {
      site,
      fromLocale,
      fromRoute,
      toLocale: locale ?? fromLocale,
      toRoute: to,
    });

    setHref(resolved);
  }, [to, locale]);

  return <a href={href}>{children}</a>;
}