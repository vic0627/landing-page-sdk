{
  "$schema": "https://json-schema.org/schema",
  "version": 2,
  "title": "vite executor",
  "description": "",
  "type": "object",
  "properties": {
    "mode": {
      "type": "string",
      "enum": ["dev", "build", "preview"],
      "description": "Choose the execution mode for Vite"
    },
    "cwd": {
      "type": "string",
      "description": "Dir of current process"
    },
    "host": {
      "type": ["string", "boolean"],
      "description": "Host for Vite dev server"
    },
    "port": {
      "type": "number",
      "description": "Port for Vite dev or preview server"
    },
    "verbose": {
      "type": "boolean",
      "description": ""
    },
    "config": {
      "type": "string",
      "description": "Config file of the project"
    },
    "sites": {
      "type": "string",
      "description": "Determining specific sites to be generated. If representing multiple values, please separate values with ','."
    },
    "minify": {
      "type": ["string", "boolean"],
      "description": ""
    },
    "versioning": {
      "type": "string",
      "enum": ["hard", "soft"],
      "description": ""
    },
    "assets": {
      "type": "string",
      "enum": ["abs", "rel"],
      "description": ""
    }
  },
  "required": ["mode", "cwd"]
}
