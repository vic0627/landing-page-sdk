{
  "name": "@landing-page-sdk/vite-pages",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./.out/index.js",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "import": "./.out/index.js",
      "require": "./.out/index.js",
      "types": "./src/index.ts"
    }
  },
  "dependencies": {
    "@landing-page-sdk/utils-node": "*"
  },
  "nx": {
    "$schema": "../../../node_modules/nx/schemas/project-schema.json",
    "sourceRoot": ".core/vite/pages/src",
    "projectType": "library",
    "targets": {
      "build": {
        "executor": "nx:run-commands",
        "options": {
          "command": "esbuild ./src/index.ts {args} ",
          "args": "--bundle --outdir=./.out --format=esm --packages=external --platform=node --minify",
          "cwd": "{projectRoot}"
        },
        "outputs": [
          "{options.outdir}"
        ]
      },
      "dev": {
        "executor": "nx:run-commands",
        "options": {
          "command": "esbuild ./src/index.ts {args} ",
          "args": "--bundle --outdir=./.out --format=esm --packages=external --platform=node --watch",
          "cwd": "{projectRoot}"
        },
        "outputs": [
          "{options.outdir}"
        ]
      }
    },
    "tags": []
  }
}
